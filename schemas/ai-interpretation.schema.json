{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viridianai.in/schemas/ai-interpretation.schema.json",
  "title": "AI Interpretation",
  "type": "object",
  "required": [
    "schemaVersion",
    "interpretationId",
    "projectId",
    "confidence",
    "evidenceIds",
    "recommendation",
    "unsupportedContentFlag"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "interpretationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "recommendation": {
      "type": "string",
      "minLength": 1
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "unsupportedContentFlag": {
      "type": "boolean"
    },
    "authorityRequested": {
      "type": [
        "string",
        "null"
      ]
    },
    "modelId": {
      "type": [
        "string",
        "null"
      ]
    },
    "promptVersion": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
