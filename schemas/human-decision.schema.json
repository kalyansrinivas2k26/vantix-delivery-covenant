{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viridianai.in/schemas/human-decision.schema.json",
  "title": "Human Decision",
  "type": "object",
  "required": [
    "schemaVersion",
    "humanDecisionId",
    "projectId",
    "authorityRole",
    "decision",
    "decidedAt",
    "evidenceIds"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "humanDecisionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "authorityRole": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "approved",
        "modified_then_approved",
        "rejected",
        "deferred",
        "more_evidence_required"
      ]
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time"
    },
    "decisionNotes": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
